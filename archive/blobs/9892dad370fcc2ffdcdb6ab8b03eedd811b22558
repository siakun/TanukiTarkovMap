ew boss, one door code, two extractions",{"ru":25,"kr":26},"Свет погас на Лаборатории: новый босс, один код от всех дверей, два выхода","연구소에 불이 꺼집니다: 새로운 보스, 모든 문을 여는 코드 하나, 탈출구 두 곳",false,"event",{"christmasTreeEnabled":27,"updated":30,"ti":31,"tr":31,"btcCraftTime":32,"fuelBase":33,"gpuBase":34,"feature_ocr":35,"feature_ocr_rate_limit":36,"tournament_day":37,"tournamentEnabled":27,"isSubdomainRedirectEnabled":27,"tarkov_pilot_version":38,"feature_tarkov_pilot":35,"feature_email_login":35,"quests_map_traderOffset":39,"email_providers_limits":49,"pilotScript":51,"pilotScriptVersion":52,"maxLayersPerMap":44,"maxLayersTotal":53,"feature_bmc":35,"price_bmc":54,"price_boosty":55,"price_patreon":56,"feature_pilot_desktop":35,"season":57,"quests_significant_rewards":59,"analyticsItemImage":69},["Date","2026-08-17T21:57:50.795Z"],0.03,300000,0.0013194444444444445,0.041225,true,60,9,"2.0.1",{"Prapor":40,"Therapist":41,"Fence":42,"Skier":43,"Peacekeeper":44,"Mechanic":45,"Ragman":46,"Jaeger":47,"Lightkeeper":44,"BTR Driver":48,"Ref":48},0,12,7,8,10,14,13,11,4,{"yandex":40,"mailersend":50},500,"& {\n    # Path to folder with screenshots (always rendered by TM website)\n    $folderPath = \"[[folder]]\"\n\n    # Path to EFT game folder (optional, case sensitive; rendered by TM website - either a path or empty).\n    # If set - used directly to locate \u003CgameFolder>\\Logs; if empty - the folder is auto-detected.\n    $gameFolderPath = \"[[game_folder]]\"\n\n    # Your user hookId, required to route your notifications to your user on TM website\n    $hookId = \"[[hookId]]\"\n\n    # API endpoint\n    $apiUrl = \"https://tarkov-market.com/api/be/pilot/script/webhook\"\n\n\n    # Check folderPath set\n    if ([string]::IsNullOrWhiteSpace($folderPath)) {\n        Write-Host \"folderPath empty. You need to set Screenshots folder on TM website.\" -ForegroundColor Red\n        Start-Sleep -Seconds 5\n        exit 1\n    }\n\n    # Folder exists\n    if (-not (Test-Path -Path $folderPath -PathType Container)) {\n        Write-Host \"Folder not found: $folderPath\" -ForegroundColor Red\n        Start-Sleep -Seconds 5\n        exit 1\n    }\n\n    # время запуска скрипта - удаляем только скриншоты текущей сессии (сделанные после старта)\n    $scriptStartTime = Get-Date\n\n    # ========================================================================\n    #  Webhook helper - all notifications go to the same endpoint with hookId\n    # ========================================================================\n    function Send-Webhook {\n        param($Payload)\n        $Payload.hookId = $hookId\n        try {\n            $body = $Payload | ConvertTo-Json -Compress\n            Invoke-RestMethod -Uri $apiUrl -Method Post `\n                -Headers @{ \"Content-Type\" = \"application/json\" } -Body $body | Out-Null\n        }\n        catch {\n            Write-Host \"Error sending webhook: $($_.Exception.Message)\" -ForegroundColor Red\n        }\n    }\n\n    # ========================================================================\n    #  Удаление скриншотов текущей сессии (сделанных после запуска скрипта).\n    #  Вызывается при смене карты.\n    # ========================================================================\n    function Remove-SessionScreenshots {\n        $deleted = 0\n        try {\n            Get-ChildItem -Path $folderPath -Filter '*.png' -File -ErrorAction SilentlyContinue |\n                Where-Object { $_.LastWriteTime -ge $scriptStartTime } |\n                ForEach-Object {\n                    try {\n                        Remove-Item -LiteralPath $_.FullName -Force -ErrorAction Stop\n                        $deleted++\n                    }\n                    catch { }\n                }\n            if ($deleted -gt 0) {\n                Write-Host \"Screenshots deleted: $deleted\" -ForegroundColor DarkGray\n            }\n        }\n        catch {\n            Write-Host \"Error cleaning screenshots: $($_.Exception.Message)\" -ForegroundColor Red\n        }\n    }\n\n    # ========================================================================\n    #  EFT logs folder detection (Steam vs standalone)\n    #  Logs always live in \u003CgameInstallDir>\\Logs; only the install dir differs.\n    # ========================================================================\n    function Get-EftLogsFolder {\n        # if the game folder is explicitly set on TM website - use it directly, skip auto-detection\n        if (-not [string]::IsNullOrWhiteSpace($gameFolderPath)) {\n            $logs = Join-Path $gameFolderPath 'Logs'\n            if (-not (Test-Path -Path $logs -PathType Container)) {\n                Write-Host \"Logs folder not found in game folder: $logs\" -ForegroundColor Yellow\n            }\n            return $logs\n        }\n\n        $candidates = @()\n\n        # 1) BSG launcher install (registry)\n        try {\n            $p = (Get-ItemProperty 'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\EscapeFromTarkov' -ErrorAction Stop).InstallLocation\n            if (-not [string]::IsNullOrWhiteSpace($p)) { $candidates += $p }\n        } catch { }\n\n        # 2) Steam libraries (parse libraryfolders.vdf)\n        $steam = $null\n        try { $steam = (Get-ItemProperty 'HKCU:\\Software\\Valve\\Steam' -ErrorAction Stop).SteamPath } catch { }\n        if ([string]::IsNullOrWhiteSpace($steam)) {\n            try { $steam = (Get-ItemProperty 'HKLM:\\SOFTWARE\\WOW6432Node\\Valve\\Steam' -ErrorAction Stop).InstallPath } catch { }\n        }\n        if (-not [string]::IsNullOrWhiteSpace($steam)) {\n            $libs = @($steam)\n            $vdf = Join-Path $steam 'steamapps\\libraryfolders.vdf'\n            if (Test-Path $vdf) {\n                foreach ($ln in (Get-Content $vdf -ErrorAction SilentlyContinue)) {\n                    if ($ln -match '\"path\"\\s*\"(.+?)\"') {\n                        $libs += ($matches[1] -replace '\\\\\\\\', '\\')\n                    }\n                }\n            }\n            foreach ($lib in $libs) {\n                # у Steam-версии игра и Logs лежат внутри подпапки build\n                $candidates += (Join-Path $lib 'steamapps\\common\\Escape from Tarkov\\build')\n            }\n        }\n\n        # 3) default standalone path\n        $candidates += 'C:\\Battlestate Games\\EFT'\n\n        # pick the Logs folder that exists and has the newest session subfolder\n        $best = $null\n        $bestTime = [datetime]::MinValue\n        foreach ($c in ($candidates | Select-Object -Unique)) {\n            $logs = Join-Path $c 'Logs'\n            if (Test-Path -Path $logs -PathType Container) {\n                $newest = Get-ChildItem -Path $logs -Directory -ErrorAction SilentlyContinue |\n                          Sort-Object CreationTime -Descending | Select-Object -First 1\n                $t = if ($newest) { $newest.CreationTime } else { (Get-Item $logs).CreationTime }\n                if ($t -gt $bestTime) { $bestTime = $t; $best = $logs }\n            }\n        }\n        return $best\n    }\n\n    # ========================================================================\n    #  SCREENSHOTS WATCHER (FileSystemWatcher + events)\n    # ========================================================================\n\n    # Deleting old watchers if any not stopped normally\n    Get-EventSubscriber | Where-Object {\n        $_.SourceObject -is [System.IO.FileSystemWatcher]\n    } | ForEach-Object {\n        Write-Host \"Old watcher: $($_.SourceIdentifier) deleted\" -ForegroundColor Yellow\n        Unregister-Event -SubscriptionId $_.SubscriptionId -Force\n    }\n\n    # Create a new FileSystemWatcher object\n    $watcher = New-Object System.IO.FileSystemWatcher\n    $watcher.Path = $folderPath\n    $watcher.Filter = \"*.png\"\n    $watcher.IncludeSubdirectories = $false\n    $watcher.EnableRaisingEvents = $true\n\n    # Specify the types of changes to watch for\n    $watcher.NotifyFilter = [System.IO.NotifyFilters]::FileName -bor `\n                            [System.IO.NotifyFilters]::LastWrite\n\n    # Action to handle file create\n    $action = {\n        $changeType = $Event.SourceEventArgs.ChangeType\n        $fileName = $Event.SourceEventArgs.Name\n\n        Write-Host \"File ${changeType}: $fileName\"\n\n        # Get variables\n        $hookId = $Event.MessageData.hookId\n        $apiUrl = $Event.MessageData.apiUrl\n\n        # Call TM website to notify\n        $body = @{\n            hookId   = $hookId\n            event    = \"screenshot\"\n            filename = $fileName\n        } | ConvertTo-Json\n\n        $headers = @{ \"Content-Type\" = \"application/json\" }\n\n        try {\n            $response = Invoke-RestMethod -Uri $apiUrl -Method Post -Headers $headers -Body $body\n            Write-Host \"File name sent: $fileName\"\n        }\n        catch {\n            Write-Host \"Error sending File name: $fileName\" -ForegroundColor Red\n            Write-Host $_.Exception.Message -ForegroundColor Red\n        }\n    }\n\n    # Pass vars inside action\n    $msgData = @{\n        hookId = $hookId\n        apiUrl = $apiUrl\n    }\n    # Register actions for specific events\n    $watcherId1 = Register-ObjectEvent -InputObject $watcher -EventName Created -Action $action -MessageData $msgData\n\n    # ========================================================================\n    #  LOGS WATCHER (polling tail - port of LogsWatcher.cs)\n    #  Map change   -> *application_*.log\n    #  Quest update -> *push-notifications_*.log\n    # ========================================================================\n\n    # Map change markers (application_*.log)\n    $LOCATION_SUBSTRING   = \"application|TRACE-NetworkGameCreate profileStatus\"\n    $LocationRe           = 'location:\\s*(?\u003Cloc>\\S+),'\n    $LOCATION_SUBSTRING2  = \"application|scene preset\"\n    $LocationRe2          = 'path:maps/(?\u003Cloc>\\w+)\\.bundle'\n\n    # Quest notification markers (push-notifications_*.log)\n    $TASK_SUBSTRING       = \"push-notifications|Got notification | ChatMessageReceived\"\n    $LINE_START_WITH_DATE = '^\\d{4}-\\d{2}-\\d{2} \\d{1,2}:\\d{1,2}:\\d{1,2}\\.\\d{3}'\n\n    # Watcher state\n    $logState = @{\n        CurrentFolder = $null\n        Positions     = @{}   # filePath -> byte offset already consumed\n    }\n\n    $logsFolder = Get-EftLogsFolder\n    if ($logsFolder) {\n        Write-Host \"Watching logs folder: $logsFolder\" -ForegroundColor Green\n    } else {\n        Write-Host \"EFT logs folder not found - map/quest tracking disabled.\" -ForegroundColor Yellow\n    }\n\n    function Get-LatestLogFolder {\n        param([string]$Root)\n        if ([string]::IsNullOrWhiteSpace($Root) -or -not (Test-Path $Root)) { return $null }\n        $dir = Get-ChildItem -Path $Root -Directory -ErrorAction SilentlyContinue |\n               Sort-Object CreationTime -Descending | Select-Object -First 1\n        if ($dir) { return $dir.FullName }\n        return $null\n    }\n\n    # Reads newly appended COMPLETE lines starting at $Position.\n    # Returns @{ Lines = \u003Cstring[]>; Position = \u003Clong> }. A trailing partial\n    # line is left unconsumed so it is re-read once fully flushed.\n    function Read-NewLines {\n        param([string]$FilePath, [long]$Position)\n\n        $out = @{ Lines = @(); Position = $Position }\n        try {\n            $fs = [System.IO.FileStream]::new(\n                $FilePath,\n                [System.IO.FileMode]::Open,\n                [System.IO.FileAccess]::Read,\n                [System.IO.FileShare]::ReadWrite)\n            try {\n                # file rotated / truncated -> restart from the beginning\n                if ($Position -gt $fs.Length) { $Position = 0 }\n\n                [void]$fs.Seek($Position, [System.IO.SeekOrigin]::Begin)\n                $sr = [System.IO.StreamReader]::new($fs, [System.Text.Encoding]::UTF8)\n                $content = $sr.ReadToEnd()\n                $endPos = $fs.Position\n                $sr.Dispose()\n\n                if ([string]::IsNullOrEmpty($content)) {\n                    $out.Position = $endPos\n                    return $out\n                }\n\n                # only consume up to the last newline; keep partial line for next tick\n                $lastNl = $content.LastIndexOf(\"`n\")\n                if ($lastNl -lt 0) {\n                    $out.Position = $Position   # no complete line yet\n                    return $out\n                }\n\n                $complete = $content.Substring(0, $lastNl + 1)\n                $partial  = $content.Substring($lastNl + 1)\n                $partialBytes = [System.Text.Encoding]::UTF8.GetByteCount($partial)\n\n                $out.Position = $endPos - $partialBytes\n                $out.Lines = $complete -split \"`r?`n\"\n            }\n            finally { $fs.Dispose() }\n        }\n        catch {\n            # file temporarily locked; retry next tick\n        }\n        return $out\n    }\n\n    function Process-LogLines {\n        param([string[]]$Lines)\n\n        for ($i = 0; $i -lt $Lines.Count; $i++) {\n            $line = $Lines[$i]\n            if ([string]::IsNullOrEmpty($line)) { continue }\n\n            if ($line.Contains($LOCATION_SUBSTRING)) {\n                $m = [regex]::Match($line, $LocationRe, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)\n                if ($m.Success) {\n                    $map = $m.Groups[\"loc\"].Value.ToLower()\n                    Write-Host \"Map change: $map\" -ForegroundColor Cyan\n                    Send-Webhook @{ event = \"map\"; map = $map }\n                    Remove-SessionScreenshots\n                }\n            }\n            elseif ($line.Contains($LOCATION_SUBSTRING2)) {\n                $m = [regex]::Match($line, $LocationRe2, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)\n                if ($m.Success) {\n                    $map = $m.Groups[\"loc\"].Value.ToLower()\n                    Write-Host \"Map change: $map\" -ForegroundColor Cyan\n                    Send-Webhook @{ event = \"map\"; map = $map }\n                    Remove-SessionScreenshots\n                }\n            }\n            elseif ($line.Contains($TASK_SUBSTRING)) {\n                # the JSON payload follows on the next lines, until the next dated record\n                $sb = New-Object System.Text.StringBuilder\n                $i++\n                while ($i -lt $Lines.Count) {\n                    $jl = $Lines[$i]\n                    if ($jl -match $LINE_START_WITH_DATE) { $i--; break }  # re-examine this line in outer loop\n                    [void]$sb.AppendLine($jl)\n                    $i++\n                }\n\n                $json = $sb.ToString()\n                if (-not [string]::IsNullOrWhiteSpace($json)) {\n                    try {\n                        $rec = $json | ConvertFrom-Json\n                        if ($rec.message -and `\n                            ($null -ne $rec.message.type) -and `\n                            $rec.message.templateId) {\n\n                            $status = \"$($rec.message.type)\"\n                            # templateId e.g. \"6574e0dedc0d635f633a5805 successMessageText\"\n                            $questId = ($rec.message.templateId -split ' ')[0]\n                            if (-not [string]::IsNullOrEmpty($questId)) {\n                                Write-Host \"Quest update: $questId status: $status\" -ForegroundColor Green\n                                Send-Webhook @{ event = \"quest\"; questId = $questId; status = $status }\n                            }\n                        }\n                    }\n                    catch {\n                        # incomplete / malformed JSON block - ignore\n                    }\n                }\n            }\n        }\n    }\n\n    function Poll-Logs {\n        if (-not $logsFolder) { return }\n\n        $latest = Get-LatestLogFolder $logsFolder\n        if (-not $latest) { return }\n\n        # switch to a newer log folder when the game is (re)started\n        if ($logState.CurrentFolder -ne $latest) {\n            $logState.CurrentFolder = $latest\n            $logState.Positions = @{}\n            Write-Host \"Active log session: $latest\" -ForegroundColor Yellow\n        }\n\n        $files = @()\n        $files += Get-ChildItem -Path $latest -Filter \"*application_*.log\"        -File -ErrorAction SilentlyContinue\n        $files += Get-ChildItem -Path $latest -Filter \"*push-notifications_*.log\" -File -ErrorAction SilentlyContinue\n\n        foreach ($f in $files) {\n            $path = $f.FullName\n\n            # first time we see this file: skip existing content, tail from EOF\n            if (-not $logState.Positions.ContainsKey($path)) {\n                $logState.Positions[$path] = $f.Length\n                continue\n            }\n\n            $res = Read-NewLines -FilePath $path -Position $logState.Positions[$path]\n            $logState.Positions[$path] = $res.Position\n            if ($res.Lines.Count -gt 0) { Process-LogLines -Lines $res.Lines }\n        }\n    }\n\n    # Write initial message\n    Write-Host \"Monitoring folder: $folderPath\"\n    Write-Host \"Press Ctrl+C to stop monitoring...\" -ForegroundColor Green\n\n    # Keep script running\n    try {\n        # Heartbeat: right away and every 60 sec - TM website shows \"Script - Active\"\n        Send-Webhook @{ event = \"status\" }\n        $lastHeartbeat = Get-Date\n\n        while ($true) {\n            Poll-Logs\n\n            if (((Get-Date) - $lastHeartbeat).TotalSeconds -ge 60) {\n                Send-Webhook @{ event = \"status\" }\n                $lastHeartbeat = Get-Date\n            }\n\n            # Wake up every second\n            Start-Sleep -Seconds 1\n        }\n    } finally {\n        # Cleanup when script is stopped\n        Write-Host \"Stopping FileSystemWatcher and cleaning up events.\"\n        Unregister-Event -SourceIdentifier $watcherId1.Name\n\n        $watcher.Dispose()\n        Write-Host \"Monitoring stopped.\" -ForegroundColor Green\n    }\n}\n","1.4",50,"7","500","8",{"enabled":35,"num":58},1,{"tags":60,"uids":65,"priceThreshold":68},[61,62,63,64],"Secure_containers","Containers","Backpacks","Keys",[66,67],"5ac84494-465a-424a-b36e-fe22869ba5ec","c760ea3c-b3b6-4b9f-83d7-5302b3f084f7",100000,"wikiIcon",{},{},null,{},{},[],{},[78,79,80,81,82,83,84,85,86,87,88],"Prapor","Therapist","Fence","Skier","Peacekeeper","Mechanic","Ragman","Jaeger","Lightkeeper","BTR Driver","Ref",[90,94,96,98,100,102,104,106],{"name":78,"levels":91},[58,92,93,48],2,3,{"name":79,"levels":95},[58,92,93,48],{"name":81,"levels":97},[58,92,93,48],{"name":82,"levels":99},[58,92,93,48],{"name":83,"levels":101},[58,92,93,48],{"name":84,"levels":103},[58,92,93,48],{"name":85,"levels":105},[58,92,93,48],{"name":88,"levels":107},[58,92,93,48],[109,110,111,112,113,114,115,116,18,117,118,119,120,121],"Ground Zero","Factory","Nighttime Factory","Customs","Woods","Shoreline","Interchange","Reserve","Lighthouse","Streets of Tarkov","The Labyrinth","Terminal","Icebreaker",[123,124,125,126,127,128,129],"Booze Generator","Intelligence Center","Lavatory","Medstation","Nutrition Unit","Water Collector","Workbench",[131,133,135,137,139,141,143],{"name":123,"levels":132},[58,92,93],{"name":124,"levels":134},[58,92,93],{"name":125,"levels":136},[58,92,93],{"name":126,"levels":138},[58,92,93],{"name":127,"levels":140},[58,92,93],{"name":128,"levels":142},[58,92,93],{"name":129,"levels":144},[58,92,93],"buy",{"result":147,"gameMode":148,"updated":149,"traders":150},"ok","PVP",1787012179914,[151,154,156,158,160,162,165,167],{"name":85,"currency":152,"nextResupply":153},"RUB",1787013916,{"name":83,"currency":152,"nextResupply":155},1787014550,{"name":88,"currency":152,"nextResupply":157},1787015632,{"name":81,"currency":152,"nextResuppl