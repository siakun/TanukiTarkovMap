<Window x:Class="TanukiTarkovMap.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:TanukiTarkovMap.ViewModels"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:converters="clr-namespace:TanukiTarkovMap.Converters"
        xmlns:behaviors="clr-namespace:TanukiTarkovMap.Behaviors"
        xmlns:views="clr-namespace:TanukiTarkovMap.Views"
        xmlns:loc="clr-namespace:TanukiTarkovMap.Localization"
        xmlns:utils="clr-namespace:TanukiTarkovMap.Models.Utils"
        mc:Ignorable="d"
        DataContext="{Binding MainWindowViewModel, Source={StaticResource Locator}}"
        Language="{DynamicResource {x:Static loc:AppLanguage.XmlLanguageKey}}"
        Title="Tanuki Tarkov Map"
        Icon="pack://application:,,,/Resources/icon.ico"
        Width="{Binding CurrentWindowWidth, Mode=TwoWay}"
        Height="{Binding CurrentWindowHeight, Mode=TwoWay}"
        Left="{Binding CurrentWindowLeft, Mode=TwoWay}"
        Top="{Binding CurrentWindowTop, Mode=TwoWay}"
        d:DesignWidth="800"
        d:DesignHeight="600"
        MinWidth="{Binding MinWidth}"
        MinHeight="{Binding MinHeight}"
        WindowStartupLocation="Manual"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="{Binding ResizeMode}"
        Topmost="{Binding IsTopmost}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <i:Interaction.Behaviors>
        <behaviors:TopBarAnimationBehavior
            TopBarTransformName="TopBarTransform"/>
        <behaviors:TrayWindowBehavior x:Name="TrayBehavior"/>
        <behaviors:WindowStateBehavior
            MainGridName="MainGrid"
            MaximizeRestoreButtonName="MaximizeRestoreButton"/>
        <behaviors:MonitorRefreshRateBehavior/>
        <behaviors:RaidFocusBehavior IsActive="{Binding IsRaidFocusActive}"/>
        <behaviors:MainWindowInitializationBehavior/>
    </i:Interaction.Behaviors>

    <Window.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BoolToToggleBackgroundConverter x:Key="BoolToToggleBackgroundConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="DimWhenDisabled" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="8"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid">
        <Border x:Name="ContentBorder"
                Style="{StaticResource WindowContentBorder}"
                Background="#FF1A1A1A"
                BorderThickness="1"
                CornerRadius="8"
                Margin="8"
                Opacity="{Binding ActualWindowOpacity}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Direction="270"
                                  ShadowDepth="0"
                                  BlurRadius="15"
                                  Opacity="0.4"/>
            </Border.Effect>
            <Border x:Name="ContentClipBorder" CornerRadius="7">
                <i:Interaction.Behaviors>
                    <behaviors:BorderClipBehavior/>
                </i:Interaction.Behaviors>
            <Grid x:Name="MainContentGrid" Panel.ZIndex="1" ClipToBounds="True">

                <Border x:Name="BrowserContainer"
                        Background="#FF212121"
                        CornerRadius="0,0,8,8"
                        ClipToBounds="True"
                        Visibility="{Binding BrowserContainerVisibility}">
                    <views:WebBrowserUserControl x:Name="WebBrowser"/>
                </Border>

                <Border x:Name="GoonsIndicator"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,24,8,0"
                        Background="#CC000000"
                        CornerRadius="4"
                        Padding="8,4"
                        Panel.ZIndex="100"
                        ToolTip="{loc:Text Goons_ToolTip}"
                        Visibility="{Binding GoonsOnCurrentMap, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Text Goons_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#FFFF4444"/>
                </Border>

                <Border x:Name="TopBar"
                        VerticalAlignment="Top"
                        Background="#FF2A2A2A"
                        CornerRadius="8,8,0,0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#FF3A3A3A"
                        Padding="8,0,0,0"
                        Panel.ZIndex="200"
                        Height="20"
                        Visibility="{Binding TopBarVisibility}"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True"
                        RenderTransformOrigin="0.5,0.5">
                    <i:Interaction.Behaviors>
                        <behaviors:WindowDragBehavior EnableMaximizeOnDoubleClick="False"/>
                    </i:Interaction.Behaviors>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TopBarTransform" Y="0"/>
                    </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Map:"
                                   Foreground="#FF888888"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="12"
                                   WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <ComboBox x:Name="MapSelector"
                                  ItemsSource="{Binding AvailableMaps}"
                                  SelectedItem="{Binding SelectedMapInfo, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource DarkComboBox}"
                                  Width="105"
                                  Height="18"
                                  FontSize="10"
                                  Foreground="White"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <Border Margin="16,0,0,0"
                                Background="#FF3A3A3A"
                                CornerRadius="3"
                                Height="16"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{Binding IsOnlineMode, Converter={StaticResource BoolToToggleBackgroundConverter}}"
                                        CornerRadius="3,0,0,3"
                                        Padding="6,0"
                                        Cursor="Hand"
                                        ToolTip="{loc:Text TopBar_Online_ToolTip}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding SetViewModeCommand}"
                                                      CommandParameter="Online"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="Online"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="1"
                                        Background="{Binding IsLocalMode, Converter={StaticResource BoolToToggleBackgroundConverter}}"
                                        Padding="6,0"
                                        Cursor="Hand"
                                        ToolTip="{loc:Text TopBar_Local_ToolTip}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding SetViewModeCommand}"
                                                      CommandParameter="Local"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="Local"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="2"
                                        Background="{Binding IsOriginMode, Converter={StaticResource BoolToToggleBackgroundConverter}}"
                                        CornerRadius="0,3,3,0"
                                        Padding="6,0"
                                        Cursor="Hand"
                                        ToolTip="{loc:Text TopBar_Origin_ToolTip}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding SetViewModeCommand}"
                                                      CommandParameter="Origin"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="Origin"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="8,0,0,0"
                                Background="#FF3A3A3A"
                                CornerRadius="3"
                                Height="16"
                                IsEnabled="{Binding AreMapControlsEnabled}"
                                Style="{StaticResource DimWhenDisabled}"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PmcButton"
                                        Grid.Column="0"
                                        Background="{Binding IsPmcExtraction, Converter={StaticResource BoolToToggleBackgroundConverter}}"
                                        CornerRadius="3,0,0,3"
                                        Padding="6,0"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding SetPmcExtractionCommand}"
                                                      CommandParameter="True"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="PMC"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="ScavButton"
                                        Grid.Column="1"
                                        Background="{Binding IsPmcExtraction, Converter={StaticResource BoolToToggleBackgroundConverter}, ConverterParameter=Invert}"
                                        CornerRadius="0,3,3,0"
                                        Padding="6,0"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding SetPmcExtractionCommand}"
                                                      CommandParameter="False"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="SCAV"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="🔍"
                                   Foreground="#FF888888"
                                   VerticalAlignment="Center"
                                   Margin="16,0,4,0"
                                   FontSize="12"
                                   WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <ComboBox x:Name="ZoomSelector"
                                  ItemsSource="{Binding AvailableZoomLevels}"
                                  SelectedItem="{Binding SelectedZoomLevel, Mode=TwoWay}"
                                  Style="{StaticResource DarkComboBox}"
                                  Width="60"
                                  Height="18"
                                  FontSize="10"
                                  Foreground="White"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0}%}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <CheckBox x:Name="HideWebElementsCheckBox"
                                  IsChecked="{Binding HideWebElements, Mode=TwoWay}"
                                  IsEnabled="{Binding AreMapControlsEnabled}"
                                  Style="{StaticResource DimWhenDisabled}"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                            <CheckBox.Content>
                                <TextBlock Text="{loc:Text TopBar_HideUi}"
                                           Foreground="#FF888888"
                                           FontSize="12"/>
                            </CheckBox.Content>
                        </CheckBox>

                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="💧"
                                   Foreground="#FF888888"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"
                                   FontSize="10"
                                   ToolTip="{loc:Text TopBar_Opacity_ToolTip}"
                                   WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Slider x:Name="OpacitySlider"
                                Width="60"
                                Height="16"
                                Minimum="0.1"
                                Maximum="1.0"
                                Value="{Binding WindowOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{loc:Text TopBar_OpacitySlider_ToolTip}">
                            <i:Interaction.Behaviors>
                                <behaviors:OpacitySliderDragBehavior/>
                            </i:Interaction.Behaviors>
                            <Slider.Style>
                                <Style TargetType="Slider">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Slider">
                                                <Grid>
                                                    <Border Background="#FF3A3A3A"
                                                            CornerRadius="2"
                                                            Height="4"
                                                            VerticalAlignment="Center"/>
                                                    <Track x:Name="PART_Track">
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Style>
                                                                    <Style TargetType="Thumb">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                    <Ellipse Width="10" Height="10"
                                                                                             Fill="#FF4A90D9"
                                                                                             Stroke="#FF5AA0E9"
                                                                                             StrokeThickness="1"/>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </Thumb.Style>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Slider.Style>
                        </Slider>
                    </StackPanel>

                    <Button x:Name="UpdateReadyButton"
                            Grid.Column="2"
                            Style="{StaticResource DownloadIconButton}"
                            Command="{Binding RestartToApplyUpdateCommand}"
                            Visibility="{Binding ShowUpdateIcon, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.Name="{loc:Text TopBar_UpdateReady_Bubble}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M8,2.5 L8,9.5 M4.5,6.5 L8,10 L11.5,6.5 M3.5,13 L12.5,13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="16" Height="16"/>
                    </Button>

                    <Canvas Grid.Column="2"
                            Width="0"
                            Height="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False">
                        <Grid Canvas.Right="-18"
                              Margin="0,3,0,0"
                              UseLayoutRounding="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowUpdateIcon}" Value="True"/>
                                                <Condition Binding="{Binding IsTopBarHidden}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border Margin="0,6,0,0"
                                    Background="#FF2A2A2A"
                                    BorderBrush="#FF3A3A3A"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,5">
                                <TextBlock Text="{loc:Text TopBar_UpdateReady_Bubble}"
                                           Foreground="#FFEAEAEA"
                                           FontSize="12"/>
                            </Border>
                            <Path Width="12"
                                  Height="7"
                                  Margin="0,0,12,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Data="M0,7 L6,0 L12,7"
                                  Fill="#FF2A2A2A"
                                  Stroke="#FF3A3A3A"
                                  StrokeThickness="1"/>
                        </Grid>
                    </Canvas>

                    <Button x:Name="SettingsButton"
                            Grid.Column="3"
                            Style="{StaticResource TitleBarIconButton}"
                            ToolTip="{loc:Text Common_Settings}"
                            Command="{Binding ToggleSettingsCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M6.65,1.64 L9.35,1.64 L9.33,3.91 L10.88,4.8 L12.83,3.65 L14.18,5.99 L12.21,7.11 L12.21,8.89 L14.18,10.01 L12.83,12.35 L10.88,11.2 L9.33,12.09 L9.35,14.36 L6.65,14.36 L6.67,12.09 L5.12,11.2 L3.17,12.35 L1.82,10.01 L3.79,8.89 L3.79,7.11 L1.82,5.99 L3.17,3.65 L5.12,4.8 L6.67,3.91 Z M8,6.1 A1.9,1.9 0 1 1 8,9.9 A1.9,1.9 0 1 1 8,6.1 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.15"
                              StrokeLineJoin="Round"
                              Width="16" Height="16"/>
                    </Button>

                    <Button x:Name="PinButton"
                            Grid.Column="4"
                            Style="{StaticResource TitleBarIconButton}"
                            Foreground="{Binding IsAlwaysOnTop, Converter={StaticResource BoolToColorConverter}}"
                            Content="📌"
                            FontSize="12"
                            Command="{Binding TogglePinModeCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource TitleBarIconButton}"
                                Content="─"
                                FontSize="10"
                                Visibility="Collapsed"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <i:Interaction.Behaviors>
                                <behaviors:WindowControlBehavior Action="Minimize"/>
                            </i:Interaction.Behaviors>
                        </Button>

                        <Button x:Name="MaximizeRestoreButton"
                                Style="{StaticResource TitleBarIconButton}"
                                Content="□"
                                FontSize="12"
                                Visibility="Collapsed"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <i:Interaction.Behaviors>
                                <behaviors:WindowControlBehavior Action="MaximizeRestore"/>
                            </i:Interaction.Behaviors>
                        </Button>

                        <Button x:Name="CloseButton"
                                Style="{StaticResource CloseIconButton}"
                                Content="✕"
                                FontSize="12"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <i:Interaction.Behaviors>
                                <behaviors:WindowControlBehavior Action="Close"/>
                            </i:Interaction.Behaviors>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
            </Border>
        </Border>

        <Border x:Name="RaidFocusHintBar"
                Panel.ZIndex="900"
                Margin="24,0,24,24"
                VerticalAlignment="Bottom"
                Padding="14,8"
                CornerRadius="6"
                Background="#EE141414"
                BorderThickness="1"
                IsHitTestVisible="False"
                Opacity="0">
            <Border.BorderBrush>
                <SolidColorBrush Color="{StaticResource ActiveBorderColor}"/>
            </Border.BorderBrush>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRaidFocusHintVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Foreground="#FFFFFFFF"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{loc:Text RaidFocus_Hint_PausePrompt}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RaidFocusHint}" Value="{x:Static utils:RaidFocusHint.Paused}">
                                <Setter Property="Text" Value="{loc:Text RaidFocus_Hint_Paused}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Border x:Name="SettingsOverlay"
                Panel.ZIndex="1000"
                Visibility="{Binding SettingsOverlayVisibility}"
                Background="#88000000"
                CornerRadius="8"
                Margin="8">
            <Grid Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSettingsCommand}"/>
                </Grid.InputBindings>

            <Border Width="620" Height="460"
                    Background="#FF1A1A1A"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="#FF3A3A3A"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <i:Interaction.Behaviors>
                    <behaviors:BlockMouseEventBehavior/>
                </i:Interaction.Behaviors>
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                      Direction="270"
                                      ShadowDepth="2"
                                      BlurRadius="12"
                                      Opacity="0.5"/>
                </Border.Effect>

                <Border CornerRadius="5">
                    <i:Interaction.Behaviors>
                        <behaviors:BorderClipBehavior/>
                    </i:Interaction.Behaviors>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FF2A2A2A"
                            CornerRadius="6,6,0,0"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#FF3A3A3A"
                            Height="24">
                        <Grid Margin="8,0,0,0">
                            <TextBlock Text="{loc:Text Common_Settings}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Button Content="✕"
                                    Style="{StaticResource CloseIconButton}"
                                    HorizontalAlignment="Right"
                                    FontSize="10"
                                    Command="{Binding CloseSettingsCommand}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            Padding="0">
                        <views:SettingsPage/>
                    </Border>
                </Grid>
                </Border>
            </Border>
            </Grid>
        </Border>

        <Border x:Name="LoadingPanel"
                Background="#DD1A1A1A"
                Visibility="Collapsed"
                Panel.ZIndex="50">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Tarkov Client"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                <TextBlock Text="{loc:Text Startup_Initializing}"
                           FontSize="16"
                           Foreground="#FF888888"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
