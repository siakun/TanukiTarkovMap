<UserControl x:Class="TanukiTarkovMap.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:TanukiTarkovMap.ViewModels"
             xmlns:behaviors="clr-namespace:TanukiTarkovMap.Behaviors"
             xmlns:loc="clr-namespace:TanukiTarkovMap.Localization"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="620"
             Background="#FF000000">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <ScrollViewer Style="{StaticResource OverlayScrollViewer}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,8">

            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Language_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource DarkComboBox}"
                              Width="240"
                              Height="24"
                              FontSize="10"
                              Foreground="White"
                              HorizontalAlignment="Left">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Text="{loc:Text Settings_Language_Hint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Paths_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Margin="0,3,0,8">
                        <TextBlock Text="{loc:Text Settings_GameFolder}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding GameFolder, UpdateSourceTrigger=LostFocus}"
                                     Height="24"
                                     Padding="6,4"
                                     FontSize="9"
                                     Background="#FF2A2A2A"
                                     Foreground="White"
                                     BorderBrush="#FF3A3A3A"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="{loc:Text Common_Browse}"
                                    Command="{Binding BrowseGameFolderCommand}"
                                    Style="{StaticResource DarkButton}"
                                    MinWidth="65"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,3,0,4">
                        <TextBlock Text="{loc:Text Settings_ScreenshotsFolder}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ScreenshotsFolder, UpdateSourceTrigger=LostFocus}"
                                     Height="24"
                                     Padding="6,4"
                                     FontSize="9"
                                     Background="#FF2A2A2A"
                                     Foreground="White"
                                     BorderBrush="#FF3A3A3A"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="{loc:Text Common_Browse}"
                                    Command="{Binding BrowseScreenshotsFolderCommand}"
                                    Style="{StaticResource DarkButton}"
                                    MinWidth="65"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Program_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="{loc:Text Settings_Hotkey_Title}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,3,0,4"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding HotkeyEnabled}"
                                  Content="{loc:Text Settings_Hotkey_Enable}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Hotkey_TrayHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   TextWrapping="Wrap"
                                   Margin="18,2,0,0"/>
                        <TextBlock Text="{loc:Text Settings_Hotkey_ScreenshotHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   TextWrapping="Wrap"
                                   Margin="18,4,0,0"/>
                        <TextBlock Text="{loc:Text Settings_Hotkey_PinHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   TextWrapping="Wrap"
                                   Margin="18,4,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="HotkeyInputPanel"
                                Orientation="Vertical"
                                Margin="24,2,0,6"
                                IsEnabled="{Binding HotkeyEnabled}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{loc:Text Settings_Hotkey_Key}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       FontSize="9"
                                       Margin="0,0,8,0"/>
                            <Button Content="{Binding HotkeyKey}"
                                    Style="{StaticResource HotkeyCaptureButton}"
                                    MinWidth="100"
                                    Focusable="True"
                                    IsTabStop="True"
                                    KeyboardNavigation.AcceptsReturn="False">
                                <i:Interaction.Behaviors>
                                    <behaviors:HotkeyInputBehavior Hotkey="{Binding HotkeyKey, Mode=TwoWay}"/>
                                </i:Interaction.Behaviors>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{loc:Text Settings_Hotkey_CaptureHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{loc:Text Settings_Cleanup_Title}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,3,0,4"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding AutoDeleteLogs}"
                                  Content="{loc:Text Settings_Cleanup_Logs}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Cleanup_LogsHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding AutoDeleteScreenshots}"
                                  Content="{loc:Text Settings_Cleanup_Screenshots}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Cleanup_ScreenshotsHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_AutoMap_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding AutoMapSwitchEnabled}"
                                  Content="{loc:Text Settings_AutoMap_RaidEntry}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_AutoMap_RaidEntryHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding ScreenshotMapSyncEnabled}"
                                  Content="{loc:Text Settings_AutoMap_Screenshot}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_AutoMap_ScreenshotHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   TextWrapping="Wrap"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Goons_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding GoonTrackerEnabled}"
                                  Content="{loc:Text Settings_Goons_Enable}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Goons_Hint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   TextWrapping="Wrap"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Share_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <TextBlock Text="{loc:Text Settings_Share_Hint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding RaidShareStatusText}"
                               Foreground="#FF4A90D9"
                               FontSize="9"
                               TextWrapping="Wrap"
                               Margin="12,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Storage_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="10"
                                   Foreground="White"
                                   VerticalAlignment="Center">
                            <Run Text="{loc:Text Settings_Storage_BrowserCache}"/>
                            <Run Text="{Binding BrowserCacheSizeText, Mode=OneWay}"
                                 Foreground="#FF4A90D9"
                                 FontWeight="SemiBold"/>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Content="{Binding CacheResetButtonText}"
                                Command="{Binding ToggleCacheResetCommand}"
                                Style="{StaticResource DarkButton}"/>
                    </Grid>

                    <TextBlock Text="{loc:Text Settings_Storage_Hint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CodeCacheLimitNotice}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{loc:Text Settings_Storage_ClearOnExit}"
                               Foreground="#FFD9A54A"
                               FontSize="8"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CacheResetScheduled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Update_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,8">
                        <CheckBox IsChecked="{Binding AutoUpdateEnabled}"
                                  Content="{loc:Text Settings_Update_Auto}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Update_AutoHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <Grid Margin="0,4,0,4">
                            <TextBlock Text="{loc:Text Settings_Update_Version}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Button Content="{loc:Text Settings_Update_Refresh}"
                                    Command="{Binding RefreshVersionsCommand}"
                                    Style="{StaticResource DarkButton}"
                                    HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableVersions}"
                                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource DarkComboBox}"
                                      Height="24"
                                      FontSize="10"
                                      Foreground="White">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Content="{loc:Text Settings_Update_Install}"
                                    Command="{Binding InstallSelectedVersionCommand}"
                                    Style="{StaticResource DarkButton}"
                                    Margin="4,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{loc:Text Settings_Update_OlderVersionHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Text Settings_Update_FullPackageHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>

                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding InstallProgress}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="#FF2A2A2A"
                                                BorderBrush="#FF3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Rectangle x:Name="PART_Track"/>
                                                <Rectangle x:Name="PART_Indicator"
                                                           Fill="#FF4A90D9"
                                                           RadiusX="3"
                                                           RadiusY="3"
                                                           HorizontalAlignment="Left"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <TextBlock Text="{Binding InstallProgressText}"
                                       Foreground="#FFAAAAAA"
                                       FontSize="9"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding UpdateStatusMessage}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateStatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{loc:Text Settings_Update_NotInstalled}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanSwitchVersion}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding LocalMapDataStatus}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Text Settings_LocalMap_DataUpdateHint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Experimental_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding PrereleaseEnabled}"
                                  Content="{loc:Text Settings_Beta_Enable}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Beta_Hint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Text Settings_Beta_RollbackHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding GameFocusHotkeyEnabled}"
                                  Content="{loc:Text Settings_GameFocusHotkey_Enable}"
                                  Foreground="White" FontSize="10" HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_GameFocusHotkey_Hint}"
                                   Foreground="#FF888888" FontSize="8" Margin="18,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding RaidFocusModeEnabled}"
                                  Content="{loc:Text Settings_RaidFocus_Enable}"
                                  Foreground="White" FontSize="10" HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_RaidFocus_Hint}"
                                   Foreground="#FF888888" FontSize="8" Margin="18,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Developer_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="{loc:Text Settings_Developer_UpdateUi}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,3,0,4"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding UpdateIconAlwaysVisible}"
                                  Content="{loc:Text Settings_Developer_UpdateIcon}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Developer_UpdateIconHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Content="{loc:Text Settings_Developer_PreviewProgress}"
                            Command="{Binding PreviewDownloadProgressCommand}"
                            Style="{StaticResource DarkButton}"
                            HorizontalAlignment="Left"
                            Margin="12,0,0,0"/>
                    <TextBlock Text="{loc:Text Settings_Developer_PreviewProgressHint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="12,4,0,10"
                               TextWrapping="Wrap"/>

                    <Button Content="{loc:Text Settings_Developer_OpenPilot}"
                            Command="{Binding NavigateToPilotCommand}"
                            Style="{StaticResource DarkButton}"
                            Height="28"
                            FontSize="10"
                            Padding="12,0"
                            HorizontalAlignment="Left"/>
                    <TextBlock Text="{loc:Text Settings_Developer_OpenPilotHint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="{loc:Text Settings_Developer_CustomUrl}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Height="24"
                                 Padding="6,4"
                                 FontSize="9"
                                 Background="#FF2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#FF3A3A3A"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="{loc:Text Settings_Developer_Go}"
                                Command="{Binding NavigateToCustomUrlCommand}"
                                Style="{StaticResource DarkButton}"
                                MinWidth="50"
                                Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{loc:Text Settings_Developer_CustomUrlHint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="{loc:Text Settings_Developer_SettingsFile}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="24"
                                 Padding="6,4"
                                 FontSize="9"
                                 Background="#FF2A2A2A"
                                 Foreground="#FFAAAAAA"
                                 BorderBrush="#FF3A3A3A"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="{loc:Text Settings_Developer_OpenFolder}"
                                Command="{Binding OpenSettingsFolderCommand}"
                                Style="{StaticResource DarkButton}"
                                MinWidth="60"
                                Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{loc:Text Settings_Developer_SettingsFileHint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#FF1E1E1E"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Resources/icon.png"
                           Width="44"
                           Height="44"
                           VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="10,0,8,0">
                        <TextBlock Text="TanukiTarkovMap"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding AppVersion}"
                                   FontSize="9"
                                   Foreground="#FF888888"
                                   Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding RepositoryUrl, Mode=OneWay}"
                                   FontSize="8"
                                   Foreground="#FF666666"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{loc:Text Settings_About_ViewOnGitHub}"
                            Command="{Binding OpenRepositoryCommand}"
                            Style="{StaticResource DarkButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
