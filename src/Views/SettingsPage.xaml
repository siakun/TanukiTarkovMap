<UserControl x:Class="TanukiTarkovMap.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:TanukiTarkovMap.ViewModels"
             xmlns:behaviors="clr-namespace:TanukiTarkovMap.Behaviors"
             xmlns:loc="clr-namespace:TanukiTarkovMap.Localization"
             xmlns:views="clr-namespace:TanukiTarkovMap.Views"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="620"
             Background="#FF000000">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="SettingsSection" TargetType="Border">
            <Setter Property="Background" Value="#FF1A1A1A"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBox}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="6,-1,0,0"/>
            <Setter Property="TextBlock.LineHeight" Value="14"/>
            <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <Style x:Key="SettingToggleLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="views:DefaultValueNotice">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource OverlayScrollViewer}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,8">

            <Border Style="{StaticResource SettingsSection}">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Language_Title}"
                               Style="{StaticResource SettingsSectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="240"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource DarkComboBox}"
                                  Height="24"
                                  FontSize="10"
                                  Foreground="White">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{loc:Text Settings_Language_Hint}"
                               Style="{StaticResource SettingsHint}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSection}">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Paths_Title}"
                               Style="{StaticResource SettingsSectionTitle}"/>

                    <StackPanel Margin="0,3,0,8">
                        <TextBlock Text="{loc:Text Settings_GameFolder}"
                                   Style="{StaticResource SettingsGroupTitle}"
                                   Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding GameFolder, UpdateSourceTrigger=LostFocus}"/>
                            <Button Grid.Column="1"
                                    Content="{loc:Text Common_Browse}"
                                    Command="{Binding BrowseGameFolderCommand}"
                                    Style="{StaticResource DarkButton}"
                                    MinWidth="65"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,3,0,4">
                        <TextBlock Text="{loc:Text Settings_ScreenshotsFolder}"
                                   Style="{StaticResource SettingsGroupTitle}"
                                   Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ScreenshotsFolder, UpdateSourceTrigger=LostFocus}"/>
                            <Button Grid.Column="1"
                                    Content="{loc:Text Common_Browse}"
                                    Command="{Binding BrowseScreenshotsFolderCommand}"
                                    Style="{StaticResource DarkButton}"
                                    MinWidth="65"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSection}">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Program_Title}"
                               Style="{StaticResource SettingsSectionTitle}"/>

                    <TextBlock Text="{loc:Text Settings_Hotkey_Title}"
                               Style="{StaticResource SettingsGroupTitle}"
                               Margin="0,3,0,4"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding HotkeyEnabled}">
                            <WrapPanel>
                                <TextBlock Text="{loc:Text Settings_Hotkey_Enable}" Style="{StaticResource SettingToggleLabel}"/>
                                <views:DefaultValueNotice Value="{Binding HotkeyEnabled}" DefaultValue="{Binding Defaults.HotkeyEnabled}"/>
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock Text="{loc:Text Settings_Hotkey_TrayHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,2,0,0"/>
                        <TextBlock Text="{loc:Text Settings_Hotkey_ScreenshotHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,4,0,0"/>
                        <TextBlock Text="{loc:Text Settings_Hotkey_PinHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,4,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="HotkeyInputPanel"
                                Orientation="Vertical"
                                Margin="24,2,0,6"
                                IsEnabled="{Binding HotkeyEnabled}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{loc:Text Settings_Hotkey_Key}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       FontSize="9"
                                       Margin="0,0,8,0"/>
                            <Button Content="{Binding HotkeyKey}"
                                    Style="{StaticResource HotkeyCaptureButton}"
                                    MinWidth="100"
                                    Focusable="True"
                                    IsTabStop="True"
                                    KeyboardNavigation.AcceptsReturn="False">
                                <i:Interaction.Behaviors>
                                    <behaviors:HotkeyInputBehavior Hotkey="{Binding HotkeyKey, Mode=TwoWay}"/>
                                </i:Interaction.Behaviors>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{loc:Text Settings_Hotkey_CaptureHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{loc:Text Settings_Cleanup_Title}"
                               Style="{StaticResource SettingsGroupTitle}"
                               Margin="0,3,0,4"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding AutoDeleteLogs}">
                            <WrapPanel>
                                <TextBlock Text="{loc:Text Settings_Cleanup_Logs}" Style="{StaticResource SettingToggleLabel}"/>
                                <views:DefaultValueNotice Value="{Binding AutoDeleteLogs}" DefaultValue="{Binding Defaults.autoDeleteLogs}"/>
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock Text="{loc:Text Settings_Cleanup_LogsHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding AutoDeleteScreenshots}">
                            <WrapPanel>
                                <TextBlock Text="{loc:Text Settings_Cleanup_Screenshots}" Style="{StaticResource SettingToggleLabel}"/>
                                <views:DefaultValueNotice Value="{Binding AutoDeleteScreenshots}" DefaultValue="{Binding Defaults.autoDeleteScreenshots}"/>
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock Text="{loc:Text Settings_Cleanup_ScreenshotsHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSection}">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_AutoMap_Title}"
                               Style="{StaticResource SettingsSectionTitle}"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding AutoMapSwitchEnabled}">
                            <WrapPanel>
                                <TextBlock Text="{loc:Text Settings_AutoMap_RaidEntry}" Style="{StaticResource SettingToggleLabel}"/>
                                <views:DefaultValueNotice Value="{Binding AutoMapSwitchEnabled}" DefaultValue="{Binding Defaults.AutoMapSwitchEnabled}"/>
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock Text="{loc:Text Settings_AutoMap_RaidEntryHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding ScreenshotMapSyncEnabled}">
                            <WrapPanel>
                                <TextBlock Text="{loc:Text Settings_AutoMap_Screenshot}" Style="{StaticResource SettingToggleLabel}"/>
                                <views:DefaultValueNotice Value="{Binding ScreenshotMapSyncEnabled}" DefaultValue="{Binding Defaults.ScreenshotMapSyncEnabled}"/>
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock Text="{loc:Text Settings_AutoMap_ScreenshotHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSection}">
                <StackPanel>
                    <TextBlock Text="{loc:Text Goons_Title}"
                               Style="{StaticResource SettingsSectionTitle}"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding GoonTrackerEnabled}">
                            <WrapPanel>
                                <TextBlock Text="{loc:Text Settings_Goons_Enable}" Style="{StaticResource SettingToggleLabel}"/>
                                <views:DefaultValueNotice Value="{Binding GoonTrackerEnabled}" DefaultValue="{Binding Defaults.GoonTrackerEnabled}"/>
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock Text="{loc:Text Settings_Goons_Hint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSection}">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Share_Title}"
                               Style="{StaticResource SettingsSectionTitle}"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <TextBlock Text="{loc:Text Settings_Share_Hint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding RaidShareStatusText}"
                               Foreground="#FF4A90D9"
                               FontSize="9"
                               TextWrapping="Wrap"
                               Margin="12,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSection}">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Storage_Title}"
                               Style="{StaticResource SettingsSectionTitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="10"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            <Run Text="{loc:Text Settings_Storage_BrowserCache}"/>
                            <Run Text="{Binding BrowserCacheSizeText, Mode=OneWay}"
                                 Foreground="#FF4A90D9"
                                 FontWeight="SemiBold"/>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Content="{Binding CacheResetButtonText}"
                                Command="{Binding ToggleCacheResetCommand}"
                                Style="{StaticResource DarkButton}"/>
                    </Grid>

                    <TextBlock Text="{loc:Text Settings_Storage_Hint}"
                               Style="{StaticResource SettingsHint}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CodeCacheLimitNotice}"
                               Style="{StaticResource SettingsHint}"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="{loc:Text Settings_Storage_ClearOnExit}"
                               Foreground="#FFD9A54A"
                               FontSize="8"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CacheResetScheduled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSection}">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Update_Title}"
                               Style="{StaticResource SettingsSectionTitle}"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,8">
                        <CheckBox IsChecked="{Binding AutoUpdateEnabled}">
                            <WrapPanel>
                                <TextBlock Text="{loc:Text Settings_Update_Auto}" Style="{StaticResource SettingToggleLabel}"/>
                                <views:DefaultValueNotice Value="{Binding AutoUpdateEnabled}" DefaultValue="{Binding Defaults.AutoUpdateEnabled}"/>
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock Text="{loc:Text Settings_Update_AutoHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <Grid Margin="0,4,0,4">
                            <TextBlock Text="{loc:Text Settings_Update_Version}"
                                       Style="{StaticResource SettingsGroupTitle}"
                                       VerticalAlignment="Center"/>
                            <Button Content="{loc:Text Settings_Update_Refresh}"
                                    Command="{Binding RefreshVersionsCommand}"
                                    Style="{StaticResource DarkButton}"
                                    HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableVersions}"
                                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource DarkComboBox}"
                                      Height="24"
                                      FontSize="10"
                                      Foreground="White">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Content="{loc:Text Settings_Update_Install}"
                                    Command="{Binding InstallSelectedVersionCommand}"
                                    Style="{StaticResource DarkButton}"
                                    Margin="4,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{loc:Text Settings_Update_OlderVersionHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="{loc:Text Settings_Update_FullPackageHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="0,2,0,0"/>

                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding InstallProgress}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="#FF2A2A2A"
                                                BorderBrush="#FF3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Rectangle x:Name="PART_Track"/>
                                                <Rectangle x:Name="PART_Indicator"
                                                           Fill="#FF4A90D9"
                                                           RadiusX="3"
                                                           RadiusY="3"
                                                           HorizontalAlignment="Left"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <TextBlock Text="{Binding InstallProgressText}"
                                       Foreground="#FFAAAAAA"
                                       FontSize="9"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding UpdateStatusMessage}"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHint}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateStatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{loc:Text Settings_Update_NotInstalled}"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHint}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanSwitchVersion}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding LocalMapDataStatus}"
                               Style="{StaticResource SettingsHint}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{loc:Text Settings_LocalMap_DataUpdateHint}"
                               Style="{StaticResource SettingsHint}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSection}">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Experimental_Title}"
                               Style="{StaticResource SettingsSectionTitle}"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding PrereleaseEnabled}">
                            <WrapPanel>
                                <TextBlock Text="{loc:Text Settings_Beta_Enable}" Style="{StaticResource SettingToggleLabel}"/>
                                <views:DefaultValueNotice Value="{Binding PrereleaseEnabled}" DefaultValue="{Binding Defaults.PrereleaseEnabled}"/>
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock Text="{loc:Text Settings_Beta_Hint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,2,0,0"/>
                        <TextBlock Text="{loc:Text Settings_Beta_RollbackHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding GameFocusHotkeyEnabled}">
                            <WrapPanel>
                                <TextBlock Text="{loc:Text Settings_GameFocusHotkey_Enable}" Style="{StaticResource SettingToggleLabel}"/>
                                <views:DefaultValueNotice Value="{Binding GameFocusHotkeyEnabled}" DefaultValue="{Binding Defaults.GameFocusHotkeyEnabled}"/>
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock Text="{loc:Text Settings_GameFocusHotkey_Hint}"
                                   Style="{StaticResource SettingsHint}" Margin="18,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding RaidFocusModeEnabled}">
                            <WrapPanel>
                                <TextBlock Text="{loc:Text Settings_RaidFocus_Enable}" Style="{StaticResource SettingToggleLabel}"/>
                                <views:DefaultValueNotice Value="{Binding RaidFocusModeEnabled}" DefaultValue="{Binding Defaults.RaidFocusModeEnabled}"/>
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock Text="{loc:Text Settings_RaidFocus_Hint}"
                                   Style="{StaticResource SettingsHint}" Margin="18,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding ViewModeSelectorEnabled}">
                            <WrapPanel>
                                <TextBlock Text="{loc:Text Settings_ViewModeSelector_Enable}" Style="{StaticResource SettingToggleLabel}"/>
                                <views:DefaultValueNotice Value="{Binding ViewModeSelectorEnabled}" DefaultValue="{Binding Defaults.ViewModeSelectorEnabled}"/>
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock Text="{loc:Text Settings_ViewModeSelector_Hint}"
                                   Style="{StaticResource SettingsHint}" Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSection}">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Developer_Title}"
                               Style="{StaticResource SettingsSectionTitle}"/>

                    <TextBlock Text="{loc:Text Settings_Developer_UpdateUi}"
                               Style="{StaticResource SettingsGroupTitle}"
                               Margin="0,3,0,4"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding UpdateIconAlwaysVisible}"
                                  Content="{loc:Text Settings_Developer_UpdateIcon}"/>
                        <TextBlock Text="{loc:Text Settings_Developer_UpdateIconHint}"
                                   Style="{StaticResource SettingsHint}"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <Button Content="{loc:Text Settings_Developer_PreviewProgress}"
                            Command="{Binding PreviewDownloadProgressCommand}"
                            Style="{StaticResource DarkButton}"
                            HorizontalAlignment="Left"
                            Margin="12,0,0,0"/>
                    <TextBlock Text="{loc:Text Settings_Developer_PreviewProgressHint}"
                               Style="{StaticResource SettingsHint}"
                               Margin="12,4,0,10"/>

                    <Button Content="{loc:Text Settings_Developer_OpenPilot}"
                            Command="{Binding NavigateToPilotCommand}"
                            Style="{StaticResource DarkButton}"
                            HorizontalAlignment="Left"/>
                    <TextBlock Text="{loc:Text Settings_Developer_OpenPilotHint}"
                               Style="{StaticResource SettingsHint}"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="{loc:Text Settings_Developer_CustomUrl}"
                               Style="{StaticResource SettingsGroupTitle}"
                               Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1"
                                Content="{loc:Text Settings_Developer_Go}"
                                Command="{Binding NavigateToCustomUrlCommand}"
                                Style="{StaticResource DarkButton}"
                                MinWidth="50"
                                Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{loc:Text Settings_Developer_CustomUrlHint}"
                               Style="{StaticResource SettingsHint}"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="{loc:Text Settings_Developer_SettingsFile}"
                               Style="{StaticResource SettingsGroupTitle}"
                               Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Foreground="#FFAAAAAA"/>
                        <Button Grid.Column="1"
                                Content="{loc:Text Settings_Developer_OpenFolder}"
                                Command="{Binding OpenSettingsFolderCommand}"
                                Style="{StaticResource DarkButton}"
                                MinWidth="60"
                                Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{loc:Text Settings_Developer_SettingsFileHint}"
                               Style="{StaticResource SettingsHint}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSection}"
                    Background="#FF1E1E1E">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Resources/icon.png"
                           Width="44"
                           Height="44"
                           VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="10,0,8,0">
                        <TextBlock Text="TanukiTarkovMap"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding AppVersion}"
                                   FontSize="9"
                                   Foreground="#FF888888"
                                   Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding RepositoryUrl, Mode=OneWay}"
                                   FontSize="8"
                                   Foreground="#FF666666"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{loc:Text Settings_About_ViewOnGitHub}"
                            Command="{Binding OpenRepositoryCommand}"
                            Style="{StaticResource DarkButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
