<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- INTENT: 빌드와 패키지 버전을 맞추고, 릴리스 태그와의 일치 여부는 배포 전에 검사한다. -->
    <Version>0.3.4</Version>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>

    <!-- Velopack: 커스텀 Main 메서드 사용 -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!-- App.xaml을 ApplicationDefinition 대신 Page로 처리 -->
  <ItemGroup>
    <Page Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- Release 모드에서만 관리자 권한 요구 (Visual Studio 디버그 모드 제외) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="ViewModels\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 모든 Resources 폴더의 파일을 exe에 임베드.
         Resources\Styles의 XAML도 여기에 걸려 Page에서 빠지므로 BAML로 컴파일되지 않고 원문 그대로 들어가
         실행 중에 해석된다. 빌드가 그 XAML의 오류를 잡지 못하고, 로컬 형식은 assembly=까지 적어야 찾는다
         (docs/20261002-wpf-xaml-resource-not-compiled.md) -->
    <Resource Include="Resources\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- JavaScript 파일을 Embedded Resource로 포함 -->
    <EmbeddedResource Include="Models\JavaScript\Scripts\*.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local 모드의 자체 미니맵과 지도 리소스. LocalViewer가 실행 파일 옆 LocalMap 폴더를
         https://tanuki-map.local/ 로 응답하므로 두 폴더를 그 아래에 나란히 둔다 -->
    <Content Include="..\..\viewer\**\*" LinkBase="LocalMap\viewer" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resources\**\*" LinkBase="LocalMap\resources" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- INTENT: 업데이트 실제 설치 검증 빌드만 업데이트를 받을 저장소를 바꾼다
       (tools/publish-update-test-release.ps1이 -p:UpdateRepositoryUrl로 넘긴다).
       값을 주지 않은 빌드는 이 메타데이터가 없어 UpdateServiceFactory의 운영 저장소 주소를 쓰므로,
       CI 릴리스와 build.bat은 테스트 저장소를 바라볼 수 없다. -->
  <ItemGroup Condition="'$(UpdateRepositoryUrl)' != ''">
    <AssemblyMetadata Include="UpdateRepositoryUrl" Value="$(UpdateRepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="141.0.110" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- INTENT: Velopack은 이 패키지의 의존성으로 들어온다. 앱에서 Velopack 버전을 따로 지정하면
         라이브러리가 동작을 확인한 버전과 어긋날 수 있으므로 직접 참조하지 않는다. -->
    <PackageReference Include="Siakun.AutoUpdate" Version="0.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>
