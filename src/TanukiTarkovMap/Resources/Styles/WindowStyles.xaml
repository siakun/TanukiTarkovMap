<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    메인 창의 테두리 색과 그 색을 쓰는 스타일.

    이 색은 두 곳에서 함께 다룬다. 창이 활성이면 밝게, 비활성이면 어둡게 하는 것은 아래
    트리거가 정하고, 핀 모드에서 마우스가 창을 벗어나면 TopBarAnimationBehavior가 1.5초에
    걸쳐 어두운 쪽으로 서서히 옮긴다. Behavior는 BorderBrush에 로컬 값을 넣어 애니메이션하고
    핀을 끄면 ClearValue로 그 값을 지워 트리거로 되돌린다.

    그래서 색 값이 한 곳에만 있어야 두 경로가 어긋나지 않는다. Behavior는 이 키를
    Application.Current.Resources["ActiveBorderColor"]로 읽으므로, 이 사전이 App.xaml에
    병합되어 있어야 한다. 리소스 사전 인덱서는 병합된 사전까지 훑으므로 여기 두어도 찾는다.
    -->
    <Color x:Key="ActiveBorderColor">#FF97C1F2</Color>
    <Color x:Key="InactiveBorderColor">#FF3A3A3A</Color>

    <!-- 창 바깥 테두리. 활성 여부에 따라 색이 바뀐다 -->
    <Style x:Key="WindowContentBorder" TargetType="Border">
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource InactiveBorderColor}"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource ActiveBorderColor}"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
