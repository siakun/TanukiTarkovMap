<!--
behaviors의 assembly=를 생략하지 않는다. Resources 폴더의 XAML은 csproj의 Resource 항목으로 원문 그대로
임베드되어 BAML로 컴파일되지 않고 실행 중에 해석된다. 이때 어셈블리를 생략한 clr-namespace는 형식을 찾지 못한다
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:TanukiTarkovMap.Behaviors;assembly=TanukiTarkovMap">

    <!--
    대상 바로 아래 가운데에 뜨고, 위쪽 꼬리로 대상을 가리키는 말풍선 툴팁.

    Windows 기본 툴팁은 밝은 상자가 마우스 커서 옆에 떠서 어두운 타이틀 바와 따로 놀고,
    어느 버튼의 설명인지도 커서 위치로만 짐작된다. 꼬리가 버튼을 직접 가리키게 한다.

    색은 맵 드롭다운 목록과 같은 바탕(#2A2A2A)과 테두리(#3A3A3A)를 써서 앱 안에서 뜨는
    다른 창과 같은 층으로 보이게 한다.

    위치는 스타일이 함께 정한다 (CalloutToolTipPlacement). 꼬리를 위쪽 가운데에 그리므로
    이 스타일을 쓰면서 Placement를 따로 지정하면 꼬리가 대상을 가리키지 않는다.
    -->
    <Style x:Key="CalloutToolTip" TargetType="ToolTip">
        <Setter Property="Placement" Value="Custom"/>
        <Setter Property="CustomPopupPlacementCallback" Value="{x:Static behaviors:CalloutToolTipPlacement.BelowCenter}"/>
        <Setter Property="Background" Value="#FF2A2A2A"/>
        <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
        <Setter Property="Foreground" Value="#FFEAEAEA"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!--
                    위 여백 3은 버튼과 꼬리 끝 사이의 틈이다. 배치 콜백은 단위가 섞인 인자를 받아
                    상수를 더할 수 없으므로 틈을 여기서 만든다 (CalloutToolTipPlacement 주석 참고)
                    -->
                    <Grid Margin="0,3,0,0" UseLayoutRounding="True">
                        <!-- 말풍선 몸통. 위 여백 6이 꼬리 높이다 -->
                        <Border Margin="0,6,0,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <!--
                        꼬리. 몸통보다 뒤에 두어 위에 그려지고, 밑변(y=7)이 몸통 위 테두리(y=6~7)를
                        덮어 그 구간의 테두리를 바탕색으로 지운다. 그래서 테두리가 꼬리 둘레로 이어진다.
                        열린 도형이라 Stroke는 빗변 두 개에만 그려지고 Fill은 닫힌 삼각형을 채운다.
                        크기를 도형과 같게 정해 두어야 선 두께가 레이아웃 크기에 섞이지 않고 정확히 가운데에 온다
                        -->
                        <Path Width="12" Height="7"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Data="M0,7 L6,0 L12,7"
                              Fill="{TemplateBinding Background}"
                              Stroke="{TemplateBinding BorderBrush}"
                              StrokeThickness="1"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
