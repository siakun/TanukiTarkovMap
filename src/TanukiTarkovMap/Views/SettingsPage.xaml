<UserControl x:Class="TanukiTarkovMap.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:TanukiTarkovMap.ViewModels"
             xmlns:behaviors="clr-namespace:TanukiTarkovMap.Behaviors"
             xmlns:loc="clr-namespace:TanukiTarkovMap.Localization"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="620"
             Background="#FF000000">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <ScrollViewer Style="{StaticResource OverlayScrollViewer}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,8">

            <!--
            INTENT
            언어 섹션을 맨 위에 둔다. 지금 화면 언어를 읽지 못하는 사람도 그 언어로 적은 언어 이름을 보고
            바로 찾아야 한다. 고르는 즉시 앱 전체 문구가 바뀌므로 확인 버튼이나 다시 시작 안내를 두지 않는다.
            선택지 문구 길이가 언어마다 달라 폭을 고정해 언어를 바꿀 때 상자가 늘었다 줄지 않게 한다
            -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Language_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource DarkComboBox}"
                              Width="240"
                              Height="24"
                              FontSize="10"
                              Foreground="White"
                              HorizontalAlignment="Left">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Text="{loc:Text Settings_Language_Hint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 타르코프 경로 설정 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Paths_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <!-- 게임 폴더 경로 -->
                    <StackPanel Margin="0,3,0,8">
                        <TextBlock Text="{loc:Text Settings_GameFolder}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding GameFolder, UpdateSourceTrigger=LostFocus}"
                                     Height="24"
                                     Padding="6,4"
                                     FontSize="9"
                                     Background="#FF2A2A2A"
                                     Foreground="White"
                                     BorderBrush="#FF3A3A3A"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="{loc:Text Common_Browse}"
                                    Command="{Binding BrowseGameFolderCommand}"
                                    Style="{StaticResource DarkButton}"
                                    MinWidth="65"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- 스크린샷 폴더 경로 -->
                    <StackPanel Margin="0,3,0,4">
                        <TextBlock Text="{loc:Text Settings_ScreenshotsFolder}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ScreenshotsFolder, UpdateSourceTrigger=LostFocus}"
                                     Height="24"
                                     Padding="6,4"
                                     FontSize="9"
                                     Background="#FF2A2A2A"
                                     Foreground="White"
                                     BorderBrush="#FF3A3A3A"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="{loc:Text Common_Browse}"
                                    Command="{Binding BrowseScreenshotsFolderCommand}"
                                    Style="{StaticResource DarkButton}"
                                    MinWidth="65"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 프로그램 설정 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Program_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <!--
                    INTENT
                    창 표시/숨김과 위치 갱신은 서로 다른 입력입니다. 앱을 종료하는 키나 게임의
                    스크린샷 키로 오해하지 않도록 두 키의 역할과 한 모니터에서의 핀 사용을 함께 설명합니다.
                    -->
                    <TextBlock Text="{loc:Text Settings_Hotkey_Title}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,3,0,4"/>

                    <!-- 단축키 활성화 -->
                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding HotkeyEnabled}"
                                  Content="{loc:Text Settings_Hotkey_Enable}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Hotkey_TrayHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   TextWrapping="Wrap"
                                   Margin="18,2,0,0"/>
                        <TextBlock Text="{loc:Text Settings_Hotkey_ScreenshotHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   TextWrapping="Wrap"
                                   Margin="18,4,0,0"/>
                        <TextBlock Text="{loc:Text Settings_Hotkey_PinHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   TextWrapping="Wrap"
                                   Margin="18,4,0,0"/>
                    </StackPanel>

                    <!-- 단축키 입력 -->
                    <StackPanel x:Name="HotkeyInputPanel"
                                Orientation="Vertical"
                                Margin="24,2,0,6"
                                IsEnabled="{Binding HotkeyEnabled}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{loc:Text Settings_Hotkey_Key}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       FontSize="9"
                                       Margin="0,0,8,0"/>
                            <!-- 입력 대기 안내("키를 눌러주세요...")는 언어에 따라 길어지므로 폭을 고정하지 않고 최소 폭만 둔다 -->
                            <Button Content="{Binding HotkeyKey}"
                                    Style="{StaticResource HotkeyCaptureButton}"
                                    MinWidth="100"
                                    Focusable="True"
                                    IsTabStop="True"
                                    KeyboardNavigation.AcceptsReturn="False">
                                <i:Interaction.Behaviors>
                                    <behaviors:HotkeyInputBehavior Hotkey="{Binding HotkeyKey, Mode=TwoWay}"/>
                                </i:Interaction.Behaviors>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{loc:Text Settings_Hotkey_CaptureHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- 파일 자동 정리 설정 -->
                    <TextBlock Text="{loc:Text Settings_Cleanup_Title}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,3,0,4"/>

                    <!-- 로그 폴더 자동 정리 -->
                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding AutoDeleteLogs}"
                                  Content="{loc:Text Settings_Cleanup_Logs}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Cleanup_LogsHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <!-- 스크린샷 자동 정리 -->
                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding AutoDeleteScreenshots}"
                                  Content="{loc:Text Settings_Cleanup_Screenshots}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Cleanup_ScreenshotsHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 자동 맵 전환 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_AutoMap_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding AutoMapSwitchEnabled}"
                                  Content="{loc:Text Settings_AutoMap_RaidEntry}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_AutoMap_RaidEntryHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding ScreenshotMapSyncEnabled}"
                                  Content="{loc:Text Settings_AutoMap_Screenshot}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_AutoMap_ScreenshotHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   TextWrapping="Wrap"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Goon Tracker 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Goons_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding GoonTrackerEnabled}"
                                  Content="{loc:Text Settings_Goons_Enable}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Goons_Hint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   TextWrapping="Wrap"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 저장 공간 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Storage_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="10"
                                   Foreground="White"
                                   VerticalAlignment="Center">
                            <Run Text="{loc:Text Settings_Storage_BrowserCache}"/>
                            <Run Text="{Binding BrowserCacheSizeText, Mode=OneWay}"
                                 Foreground="#FF4A90D9"
                                 FontWeight="SemiBold"/>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Content="{Binding CacheResetButtonText}"
                                Command="{Binding ToggleCacheResetCommand}"
                                Style="{StaticResource DarkButton}"/>
                    </Grid>

                    <TextBlock Text="{loc:Text Settings_Storage_Hint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CodeCacheLimitNotice}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>

                    <!-- 실행 중에는 CEF가 파일을 붙들고 있어 지울 수 없으므로 언제 지워지는지 알린다 -->
                    <TextBlock Text="{loc:Text Settings_Storage_ClearOnExit}"
                               Foreground="#FFD9A54A"
                               FontSize="8"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CacheResetScheduled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 업데이트 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Update_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <!-- 자동 업데이트 -->
                    <StackPanel Orientation="Vertical" Margin="12,2,0,8">
                        <CheckBox IsChecked="{Binding AutoUpdateEnabled}"
                                  Content="{loc:Text Settings_Update_Auto}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Update_AutoHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <!-- 버전 선택: 올리는 방향과 되돌리는 방향을 같은 목록에서 고른다 -->
                    <StackPanel>
                        <Grid Margin="0,4,0,4">
                            <TextBlock Text="{loc:Text Settings_Update_Version}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Button Content="{loc:Text Settings_Update_Refresh}"
                                    Command="{Binding RefreshVersionsCommand}"
                                    Style="{StaticResource DarkButton}"
                                    HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableVersions}"
                                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource DarkComboBox}"
                                      Height="24"
                                      FontSize="10"
                                      Foreground="White">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Content="{loc:Text Settings_Update_Install}"
                                    Command="{Binding InstallSelectedVersionCommand}"
                                    Style="{StaticResource DarkButton}"
                                    Margin="4,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{loc:Text Settings_Update_OlderVersionHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Text Settings_Update_FullPackageHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- 다운로드 진행 상황 (Velopack이 정수 퍼센트만 알려주므로 MB는 그 값으로 환산한 추정치다) -->
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding InstallProgress}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="#FF2A2A2A"
                                                BorderBrush="#FF3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Rectangle x:Name="PART_Track"/>
                                                <Rectangle x:Name="PART_Indicator"
                                                           Fill="#FF4A90D9"
                                                           RadiusX="3"
                                                           RadiusY="3"
                                                           HorizontalAlignment="Left"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <TextBlock Text="{Binding InstallProgressText}"
                                       Foreground="#FFAAAAAA"
                                       FontSize="9"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 조회나 설치가 실패했을 때만 그 사정을 남긴다 -->
                    <TextBlock Text="{Binding UpdateStatusMessage}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateStatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 설치 관리자가 없는 실행 형태에서는 교체할 대상이 없다 -->
                    <TextBlock Text="{loc:Text Settings_Update_NotInstalled}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanSwitchVersion}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 실험적 기능 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Experimental_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding PrereleaseEnabled}"
                                  Content="{loc:Text Settings_Beta_Enable}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Beta_Hint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Text Settings_Beta_RollbackHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 항목 구분선 -->
                    <Border Height="1"
                            Background="#FF333333"
                            Margin="0,8,0,8"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding LocalMapEnabled}"
                                  Content="{loc:Text Settings_LocalMap_Enable}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_LocalMap_Hint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LocalMapDataStatus}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Text Settings_LocalMap_DataUpdateHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 개발자 도구 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Settings_Developer_Title}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <!-- 업데이트 UI 확인: 개발 빌드에서는 실제 업데이트가 잡히지 않아 볼 방법이 없다 -->
                    <TextBlock Text="{loc:Text Settings_Developer_UpdateUi}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,3,0,4"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding UpdateIconAlwaysVisible}"
                                  Content="{loc:Text Settings_Developer_UpdateIcon}"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Text Settings_Developer_UpdateIconHint}"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Content="{loc:Text Settings_Developer_PreviewProgress}"
                            Command="{Binding PreviewDownloadProgressCommand}"
                            Style="{StaticResource DarkButton}"
                            HorizontalAlignment="Left"
                            Margin="12,0,0,0"/>
                    <TextBlock Text="{loc:Text Settings_Developer_PreviewProgressHint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="12,4,0,10"
                               TextWrapping="Wrap"/>

                    <!-- Pilot 설정 페이지로 이동 -->
                    <Button Content="{loc:Text Settings_Developer_OpenPilot}"
                            Command="{Binding NavigateToPilotCommand}"
                            Style="{StaticResource DarkButton}"
                            Height="28"
                            FontSize="10"
                            Padding="12,0"
                            HorizontalAlignment="Left"/>
                    <TextBlock Text="{loc:Text Settings_Developer_OpenPilotHint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,4,0,0"/>

                    <!-- URL 직접 입력 -->
                    <TextBlock Text="{loc:Text Settings_Developer_CustomUrl}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Height="24"
                                 Padding="6,4"
                                 FontSize="9"
                                 Background="#FF2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#FF3A3A3A"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="{loc:Text Settings_Developer_Go}"
                                Command="{Binding NavigateToCustomUrlCommand}"
                                Style="{StaticResource DarkButton}"
                                MinWidth="50"
                                Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{loc:Text Settings_Developer_CustomUrlHint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,2,0,0"/>

                    <!-- 설정 파일 경로 -->
                    <TextBlock Text="{loc:Text Settings_Developer_SettingsFile}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="24"
                                 Padding="6,4"
                                 FontSize="9"
                                 Background="#FF2A2A2A"
                                 Foreground="#FFAAAAAA"
                                 BorderBrush="#FF3A3A3A"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="{loc:Text Settings_Developer_OpenFolder}"
                                Command="{Binding OpenSettingsFolderCommand}"
                                Style="{StaticResource DarkButton}"
                                MinWidth="60"
                                Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{loc:Text Settings_Developer_SettingsFileHint}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!--
                정보: 시작 화면에서 스쳐 지나가는 아이콘을 여기서는 느긋하게 볼 수 있다.
                스플래시는 시작을 늦추지 않으려고 빠른 실행에서는 아예 뜨지 않으므로
                (docs/20260816-startup-speed-and-updates.md), 아이콘이 머무를 자리를 따로 둔다
            -->
            <Border Background="#FF1E1E1E"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Resources/icon.png"
                           Width="44"
                           Height="44"
                           VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="10,0,8,0">
                        <TextBlock Text="TanukiTarkovMap"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding AppVersion}"
                                   FontSize="9"
                                   Foreground="#FF888888"
                                   Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding RepositoryUrl, Mode=OneWay}"
                                   FontSize="8"
                                   Foreground="#FF666666"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{loc:Text Settings_About_ViewOnGitHub}"
                            Command="{Binding OpenRepositoryCommand}"
                            Style="{StaticResource DarkButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
