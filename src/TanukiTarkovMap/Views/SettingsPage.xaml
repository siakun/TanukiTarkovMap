<UserControl x:Class="TanukiTarkovMap.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:TanukiTarkovMap.ViewModels"
             xmlns:behaviors="clr-namespace:TanukiTarkovMap.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="620"
             Background="#FF000000">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <ScrollViewer Style="{StaticResource OverlayScrollViewer}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,8">

            <!-- 타르코프 경로 설정 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="타르코프 경로 설정"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <!-- 게임 폴더 경로 -->
                    <StackPanel Margin="0,3,0,8">
                        <TextBlock Text="게임 폴더 경로 / Game Folder Path"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding GameFolder, UpdateSourceTrigger=LostFocus}"
                                     Height="24"
                                     Padding="6,4"
                                     FontSize="9"
                                     Background="#FF2A2A2A"
                                     Foreground="White"
                                     BorderBrush="#FF3A3A3A"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="찾아보기"
                                    Command="{Binding BrowseGameFolderCommand}"
                                    Style="{StaticResource DarkButton}"
                                    Width="65"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- 스크린샷 폴더 경로 -->
                    <StackPanel Margin="0,3,0,4">
                        <TextBlock Text="스크린샷 폴더 경로 / Screenshots Folder Path"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ScreenshotsFolder, UpdateSourceTrigger=LostFocus}"
                                     Height="24"
                                     Padding="6,4"
                                     FontSize="9"
                                     Background="#FF2A2A2A"
                                     Foreground="White"
                                     BorderBrush="#FF3A3A3A"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="찾아보기"
                                    Command="{Binding BrowseScreenshotsFolderCommand}"
                                    Style="{StaticResource DarkButton}"
                                    Width="65"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 프로그램 설정 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="프로그램 설정"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <!-- 전역 단축키 설정 -->
                    <TextBlock Text="전역 단축키"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,3,0,4"/>

                    <!-- 단축키 활성화 -->
                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding HotkeyEnabled}"
                                  Content="전역 단축키 사용"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="단축키로 프로그램을 트레이로 숨기거나 표시합니다"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <!-- 단축키 입력 -->
                    <StackPanel x:Name="HotkeyInputPanel"
                                Orientation="Vertical"
                                Margin="24,2,0,6"
                                IsEnabled="{Binding HotkeyEnabled}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="단축키:"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       FontSize="9"
                                       Margin="0,0,8,0"/>
                            <Button Content="{Binding HotkeyKey}"
                                    Style="{StaticResource HotkeyCaptureButton}"
                                    Width="100"
                                    Focusable="True"
                                    IsTabStop="True"
                                    KeyboardNavigation.AcceptsReturn="False">
                                <i:Interaction.Behaviors>
                                    <behaviors:HotkeyInputBehavior Hotkey="{Binding HotkeyKey, Mode=TwoWay}"/>
                                </i:Interaction.Behaviors>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="(클릭 후 키를 눌러 설정하세요)"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- 파일 자동 정리 설정 -->
                    <TextBlock Text="파일 자동 정리"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,3,0,4"/>

                    <!-- 로그 폴더 자동 정리 -->
                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding AutoDeleteLogs}"
                                  Content="로그 폴더 자동 정리"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="프로그램 시작 시 이전 로그 폴더를 자동으로 삭제합니다"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <!-- 스크린샷 자동 정리 -->
                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding AutoDeleteScreenshots}"
                                  Content="스크린샷 자동 정리"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="레이드 종료 시 스크린샷을 자동으로 삭제합니다"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 자동 맵 전환 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="자동 맵 전환"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding AutoMapSwitchEnabled}"
                                  Content="레이드 진입 시 맵 자동 전환"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="게임 로그에서 입장한 맵을 감지해 화면을 그 맵으로 바꿉니다"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Goon Tracker 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Goon Tracker"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding GoonTrackerEnabled}"
                                  Content="Goon Tracker 사용"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="tarkov-goon-tracker.com에서 Goons 위치 정보를 가져옵니다"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 저장 공간 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="저장 공간"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="10"
                                   Foreground="White"
                                   VerticalAlignment="Center">
                            <Run Text="브라우저 캐시"/>
                            <Run Text="{Binding BrowserCacheSizeText, Mode=OneWay}"
                                 Foreground="#FF4A90D9"
                                 FontWeight="SemiBold"/>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Content="{Binding CacheResetButtonText}"
                                Command="{Binding ToggleCacheResetCommand}"
                                Style="{StaticResource DarkButton}"/>
                    </Grid>

                    <TextBlock Text="맵 타일 이미지와 페이지 스크립트가 쌓인 자리입니다. 비워도 설정은 그대로이고, 맵을 다시 열 때 새로 받습니다"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CodeCacheLimitNotice}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>

                    <!-- 실행 중에는 CEF가 파일을 붙들고 있어 지울 수 없으므로 언제 지워지는지 알린다 -->
                    <TextBlock Text="프로그램을 닫을 때 비웁니다"
                               Foreground="#FFD9A54A"
                               FontSize="8"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CacheResetScheduled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 업데이트 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="업데이트"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <!-- 자동 업데이트 -->
                    <StackPanel Orientation="Vertical" Margin="12,2,0,8">
                        <CheckBox IsChecked="{Binding AutoUpdateEnabled}"
                                  Content="자동 업데이트"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="새 버전이 나오면 백그라운드로 받아 두고 프로그램을 닫을 때 적용합니다"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"/>
                    </StackPanel>

                    <!-- 버전 선택: 올리는 방향과 되돌리는 방향을 같은 목록에서 고른다 -->
                    <StackPanel>
                        <Grid Margin="0,4,0,4">
                            <TextBlock Text="버전 선택"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Button Content="목록 새로고침"
                                    Command="{Binding RefreshVersionsCommand}"
                                    Style="{StaticResource DarkButton}"
                                    HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableVersions}"
                                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource DarkComboBox}"
                                      Height="24"
                                      FontSize="10"
                                      Foreground="White">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Content="선택한 버전 설치"
                                    Command="{Binding InstallSelectedVersionCommand}"
                                    Style="{StaticResource DarkButton}"
                                    Margin="4,0,0,0"/>
                        </Grid>

                        <TextBlock Text="최신이 아닌 버전을 고르면 자동 업데이트가 함께 꺼집니다. 다만 이 설정이 없던 옛 버전에서는 그 버전이 스스로 최신을 받아 오므로 계속 머무를 수 없습니다"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="버전 전환은 전체 패키지를 받으므로 시간이 걸립니다"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- 다운로드 진행 상황 (Velopack이 정수 퍼센트만 알려주므로 MB는 그 값으로 환산한 추정치다) -->
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding InstallProgress}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="#FF2A2A2A"
                                                BorderBrush="#FF3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Rectangle x:Name="PART_Track"/>
                                                <Rectangle x:Name="PART_Indicator"
                                                           Fill="#FF4A90D9"
                                                           RadiusX="3"
                                                           RadiusY="3"
                                                           HorizontalAlignment="Left"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <TextBlock Text="{Binding InstallProgressText}"
                                       Foreground="#FFAAAAAA"
                                       FontSize="9"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 조회나 설치가 실패했을 때만 그 사정을 남긴다 -->
                    <TextBlock Text="{Binding UpdateStatusMessage}"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateStatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 설치 관리자가 없는 실행 형태에서는 교체할 대상이 없다 -->
                    <TextBlock Text="설치본에서만 버전을 바꿀 수 있습니다. 지금은 포터블이나 개발 빌드로 실행 중입니다"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanSwitchVersion}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 실험적 기능 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="실험적 기능"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,4">
                        <CheckBox IsChecked="{Binding PrereleaseEnabled}"
                                  Content="베타 버전 받기"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="v0.1.1-beta처럼 정식 출시 전 버전을 버전 목록과 자동 업데이트 대상에 넣습니다"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="시험 중인 빌드라 문제가 있을 수 있습니다. 되돌리려면 이 항목을 끄고 버전 목록에서 정식 버전을 골라 설치하세요"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 개발자 도구 섹션 -->
            <Border Background="#FF1A1A1A"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="개발자 도구"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <!-- 업데이트 UI 확인: 개발 빌드에서는 실제 업데이트가 잡히지 않아 볼 방법이 없다 -->
                    <TextBlock Text="업데이트 UI 확인"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,3,0,4"/>

                    <StackPanel Orientation="Vertical" Margin="12,2,0,6">
                        <CheckBox IsChecked="{Binding UpdateIconAlwaysVisible}"
                                  Content="타이틀 바 다운로드 아이콘 항상 표시"
                                  Foreground="White"
                                  FontSize="10"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="설정 파일에 저장하지 않으므로 프로그램을 다시 켜면 꺼집니다"
                                   Foreground="#FF888888"
                                   FontSize="8"
                                   Margin="18,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Content="다운로드 진행률 미리보기"
                            Command="{Binding PreviewDownloadProgressCommand}"
                            Style="{StaticResource DarkButton}"
                            HorizontalAlignment="Left"
                            Margin="12,0,0,0"/>
                    <TextBlock Text="위쪽 업데이트 섹션의 진행률 막대를 실제 설치 없이 재생합니다. 눌러 두고 그쪽으로 올려서 보세요"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="12,4,0,10"
                               TextWrapping="Wrap"/>

                    <!-- Pilot 설정 페이지로 이동 -->
                    <Button Content="Tarkov Market 설정 페이지로 이동"
                            Command="{Binding NavigateToPilotCommand}"
                            Style="{StaticResource DarkButton}"
                            Height="28"
                            FontSize="10"
                            Padding="12,0"
                            HorizontalAlignment="Left"/>
                    <TextBlock Text="tarkov-market.com/pilot 페이지를 표시합니다"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,4,0,0"/>

                    <!-- URL 직접 입력 -->
                    <TextBlock Text="URL 직접 이동"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Height="24"
                                 Padding="6,4"
                                 FontSize="9"
                                 Background="#FF2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#FF3A3A3A"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="이동"
                                Command="{Binding NavigateToCustomUrlCommand}"
                                Style="{StaticResource DarkButton}"
                                Width="50"
                                Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Text="디버그 모드로 지정된 URL로 이동합니다 (JavaScript 비활성화)"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,2,0,0"/>

                    <!-- 설정 파일 경로 -->
                    <TextBlock Text="설정 파일 경로"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="24"
                                 Padding="6,4"
                                 FontSize="9"
                                 Background="#FF2A2A2A"
                                 Foreground="#FFAAAAAA"
                                 BorderBrush="#FF3A3A3A"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="폴더 열기"
                                Command="{Binding OpenSettingsFolderCommand}"
                                Style="{StaticResource DarkButton}"
                                Width="60"
                                Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Text="settings.json 파일이 저장된 폴더를 엽니다"
                               Foreground="#FF888888"
                               FontSize="8"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!--
                정보: 시작 화면에서 스쳐 지나가는 아이콘을 여기서는 느긋하게 볼 수 있다.
                스플래시는 시작을 늦추지 않으려고 빠른 실행에서는 아예 뜨지 않으므로
                (docs/startup-speed-and-updates.md), 아이콘이 머무를 자리를 따로 둔다
            -->
            <Border Background="#FF1E1E1E"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/Resources/icon.png"
                           Width="56"
                           Height="56"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="TanukiTarkovMap"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding AppVersion}"
                               FontSize="10"
                               Foreground="#FF888888"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                    <Button Content="GitHub에서 보기"
                            Command="{Binding OpenRepositoryCommand}"
                            Style="{StaticResource DarkButton}"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding RepositoryUrl, Mode=OneWay}"
                               FontSize="8"
                               Foreground="#FF666666"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
